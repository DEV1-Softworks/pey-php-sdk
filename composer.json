{
    "name": "dev1/pey-php-sdk",
    "description": "Unofficial PHP SDK for the Pey API (CoDi payments, Mexico). Not affiliated with Pey or Banco de México.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "pey",
        "codi",
        "banxico",
        "payments",
        "mexico",
        "sdk",
        "psr-18",
        "webhooks"
    ],
    "homepage": "https://github.com/DEV1-Softworks/pey-php-sdk",
    "support": {
        "issues": "https://github.com/DEV1-Softworks/pey-php-sdk/issues",
        "source": "https://github.com/DEV1-Softworks/pey-php-sdk"
    },
    "authors": [
        {
            "name": "DEV1 Softworks Labs",
            "email": "it@dev1.mx"
        }
    ],
    "require": {
        "php": "^8.2",
        "php-http/discovery": "^1.20",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "ext-simplexml": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "guzzlehttp/guzzle": "^7.9",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^11.5",
        "symfony/http-client": "^6.4 || ^7.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "PSR-18 client the SDK configures with exact connect and total timeouts (preferred).",
        "nyholm/psr7": "PSR-17 factories, if your project has none.",
        "symfony/http-client": "PSR-18 client the SDK configures with timeouts (no separate connect timeout)."
    },
    "autoload": {
        "psr-4": {
            "Dev1\\Pey\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dev1\\Pey\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-clover build/coverage.xml --coverage-text",
            "@php tools/coverage-check.php build/coverage.xml"
        ],
        "analyse": "phpstan analyse --memory-limit=1G --no-progress",
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite.",
        "test:coverage": "Run the test suite with coverage and enforce the coverage thresholds.",
        "analyse": "Run PHPStan at level max with strict rules (no baseline).",
        "cs": "Check coding standards (PER-CS) without modifying files.",
        "cs:fix": "Fix coding standards (PER-CS) in place."
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
